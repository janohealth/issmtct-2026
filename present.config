# Settings for present.command. Change these to match this Mac.
# Folder of the app repo (the one deployed to jano-functional.pages.dev):
APP_DIR="$HOME/Jano Health/ehr-prototype"
# Ports (the deck expects the app on 4173):
APP_PORT=4173
DECK_PORT=4174
# Commands to build and serve the app:
APP_BUILD="npm run build"
APP_SERVE="npm run preview -- --host 127.0.0.1 --port $APP_PORT --strictPort"
