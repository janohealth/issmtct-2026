# Settings for present.command. Change these to match this Mac.
# The app repo. Its publish branch holds the deployed build (the files jano-functional.pages.dev serves).
APP_REPO="$HOME/Jano Health/ehr-prototype"
APP_BRANCH="publish-therapy"
APP_SUBDIR="public"
# Where the Mac keeps its copy of the deployed build (refreshed on each run when there is internet):
APP_CACHE="$HOME/Jano Health/.issmtct-app"
# Ports. The deck expects the app on 4173.
APP_PORT=4173
DECK_PORT=4174
# iPhone remote: 1 = on, 0 = off. The phone and this Mac must share a network (best: the iPhone's Personal Hotspot).
REMOTE=1
REMOTE_PORT=4175
# Set to 0 to not open a browser window.
OPEN_BROWSER=1
